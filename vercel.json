{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{webapp/**,.venv/**,tests/**,.git/**,data/raw/**,data/cache/**,data/hpo/*.pickle,**/__pycache__/**}",
      "includeFiles": "{src/**,data/hosted/**,data/hpo/*.obo,data/hpo/*.hpoa}"
    }
  },
  "routes": [
    {
      "src": "/api/.*",
      "dest": "/api/index"
    },
    {
      "src": "/health",
      "dest": "/api/index"
    }
  ],
  "buildCommand": "python3 scripts/prepare_hosted.py"
}
