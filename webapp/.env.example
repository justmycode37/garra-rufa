# Landing-page AI only; workspace AI uses the signed-in ChatGPT plan.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-6-luna
OPENAI_WORKSPACE_MODEL=gpt-6-astra
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# Persistent local disk; mount a volume at this path in production.
GARRA_DATA_DIR=./data
# Leave blank locally, or use http://127.0.0.1:<port>.
# Public hosted ChatGPT access requires separate OpenAI approval.
APP_ORIGIN=

# Python graph and dedicated literature pipelines (npm run dev:all starts both).
GARRA_RESEARCH_URL=http://127.0.0.1:8787

# Optional voice input: server-only ElevenLabs speech-to-text credential.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Supabase: publishable key only; never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://mhmbyajftzuyqffpajfb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
