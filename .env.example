# Required for OpenAI narrative (optional — fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PubMed etiquette
NCBI_EMAIL=you@example.com

# Bright Data Web Unlocker (query-test: sites behind Cloudflare, e.g. globalgenes.org)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# OpenRouter LLM for the evidence graph (src/query-test/evidence)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/space-bunny-alpha
